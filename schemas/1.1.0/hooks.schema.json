{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/1.1.0/hooks.schema.json",
  "title": "Agent Plugins Hooks Configuration",
  "description": "Machine-readable schema for hooks.json in Agent Plugins 1.1.0. The Agent Plugins specification defines additional semantic and operational requirements.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://agent-plugins.org/schemas/1.1.0/hooks.schema.json",
      "description": "Canonical identifier of the hooks configuration schema for the Agent Plugins version targeted by this document."
    },
    "hooks": {
      "type": "object",
      "properties": {
        "tool.before": {
          "$ref": "#/$defs/handlers"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["$schema", "hooks"],
  "additionalProperties": false,
  "$defs": {
    "handlers": {
      "title": "Hook handlers",
      "type": "array",
      "items": {
        "$ref": "#/$defs/handler"
      },
      "minItems": 1
    },
    "handler": {
      "title": "Hook handler",
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Executable token. Resolution rules are defined by the Agent Plugins specification."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "toolBeforeInput": {
      "title": "tool.before input",
      "type": "object",
      "properties": {
        "hook_event_name": {
          "const": "tool.before"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "tool_use_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "tool_input": true,
        "tool_profile": {
          "$ref": "#/$defs/toolProfile"
        }
      },
      "required": [
        "hook_event_name",
        "session_id",
        "cwd",
        "tool_use_id",
        "tool_name",
        "tool_input"
      ],
      "additionalProperties": false
    },
    "toolProfile": {
      "title": "Portable tool profile",
      "oneOf": [
        {
          "$ref": "#/$defs/mcpToolProfile"
        },
        {
          "$ref": "#/$defs/shellToolProfile"
        },
        {
          "$ref": "#/$defs/fileReadToolProfile"
        },
        {
          "$ref": "#/$defs/fileModifyToolProfile"
        },
        {
          "$ref": "#/$defs/webFetchToolProfile"
        },
        {
          "$ref": "#/$defs/webSearchToolProfile"
        }
      ]
    },
    "mcpToolProfile": {
      "title": "MCP tool profile",
      "type": "object",
      "properties": {
        "name": {
          "const": "mcp"
        },
        "input": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          },
          "required": ["name", "arguments"],
          "additionalProperties": false
        }
      },
      "required": ["name", "input"],
      "additionalProperties": false
    },
    "shellToolProfile": {
      "title": "Shell tool profile",
      "type": "object",
      "properties": {
        "name": {
          "const": "shell"
        },
        "input": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": ["command"],
          "additionalProperties": false
        }
      },
      "required": ["name", "input"],
      "additionalProperties": false
    },
    "fileReadToolProfile": {
      "title": "File read tool profile",
      "type": "object",
      "properties": {
        "name": {
          "const": "file.read"
        },
        "input": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["path"],
          "additionalProperties": false
        }
      },
      "required": ["name", "input"],
      "additionalProperties": false
    },
    "fileModifyToolProfile": {
      "title": "File modification tool profile",
      "type": "object",
      "properties": {
        "name": {
          "const": "file.modify"
        },
        "input": {
          "type": "object",
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fileEditOperation"
                  },
                  {
                    "$ref": "#/$defs/fileWriteOperation"
                  },
                  {
                    "$ref": "#/$defs/fileDeleteOperation"
                  },
                  {
                    "$ref": "#/$defs/fileMoveOperation"
                  }
                ]
              }
            }
          },
          "required": ["operations"],
          "additionalProperties": false
        }
      },
      "required": ["name", "input"],
      "additionalProperties": false
    },
    "fileEditOperation": {
      "title": "File edit operation",
      "type": "object",
      "properties": {
        "kind": {
          "const": "edit"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    },
    "fileWriteOperation": {
      "title": "File write operation",
      "type": "object",
      "properties": {
        "kind": {
          "const": "write"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    },
    "fileDeleteOperation": {
      "title": "File delete operation",
      "type": "object",
      "properties": {
        "kind": {
          "const": "delete"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    },
    "fileMoveOperation": {
      "title": "File move operation",
      "type": "object",
      "properties": {
        "kind": {
          "const": "move"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "from", "to"],
      "additionalProperties": false
    },
    "webFetchToolProfile": {
      "title": "Web fetch tool profile",
      "type": "object",
      "properties": {
        "name": {
          "const": "web.fetch"
        },
        "input": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["urls"],
          "additionalProperties": false
        }
      },
      "required": ["name", "input"],
      "additionalProperties": false
    },
    "webSearchToolProfile": {
      "title": "Web search tool profile",
      "type": "object",
      "properties": {
        "name": {
          "const": "web.search"
        },
        "input": {
          "type": "object",
          "properties": {
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["queries"],
          "additionalProperties": false
        }
      },
      "required": ["name", "input"],
      "additionalProperties": false
    },
    "toolBeforeOutput": {
      "title": "tool.before output",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "allow"
            }
          },
          "required": ["decision"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "deny"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["decision", "reason"],
          "additionalProperties": false
        }
      ]
    }
  }
}
